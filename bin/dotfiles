#!/bin/zsh
#
# Script Name: dotfiles
# Date: 07/25/2026
#
# dotfiles is a bare-repo dotfiles manager with some extras

_DOTFILES_GIT_DIR="$HOME/.cfg"
_DOTFILES_WORK_TREE="$HOME"

_df_git() {
    git --work-tree="$_DOTFILES_WORK_TREE" --git-dir="$_DOTFILES_GIT_DIR" "$@"
}

_save() {
    local msg="${1:-dotfiles: $(date +%Y-%m-%d)}"
    _df_git add -u
    _df_git commit -m "$msg"
    _df_git push
}

_edit() {
    local file
    file=$(_df_git ls-files --full-name "$_DOTFILES_WORK_TREE" | sort | fzf --preview "bat --color=always --style=plain $HOME/{}")
    [[ -z "$file" ]] && return
    ${EDITOR:-vi} "$_DOTFILES_WORK_TREE/$file"
    if [[ -n "$(_df_git status --porcelain "$_DOTFILES_WORK_TREE/$file")" ]]; then
        read -rq "REPLY?Commit and push changes to $file? [y/N] "
        echo
        [[ "$REPLY" == "y" ]] && _save "dotfiles: update $file"
    fi
}

_help() {
    cat <<'EOF'
dotfiles -- bare-repo dotfiles manager (~/.cfg, work-tree $HOME)

    save [msg]  stage all tracked changes, commit, and push
    edit        fzf picker over tracked files, open in $EDITOR, offer to save
    help        show this message

All other subcommands pass through to git.
EOF
}

case "$1" in
    save) _save "${@:2}" ;;
    edit) _edit ;;
    help) _help ;;
    *)    _df_git "$@" ;;
esac
